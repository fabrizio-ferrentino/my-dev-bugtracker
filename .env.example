# --- Supabase (public, safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only, NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (server only) ---
RESEND_API_KEY=
# Admin inbox for new-ticket notifications
ADMIN_EMAIL=
# Verified sender, e.g. "Bug Tracker <bugs@example.com>"
RESEND_FROM_EMAIL=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App branding / URLs (no personal data hardcoded in code) ---
# Public base URL of this deployment, e.g. https://bugs.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Short product name shown in UI and emails
NEXT_PUBLIC_SITE_NAME=Bug Tracker
# Tagline shown under the public form title
NEXT_PUBLIC_SITE_TAGLINE=Found a bug or something that doesn't work? Send a report and we'll take care of it.
# Optional: comma-separated applications for the reporter dropdown.
# When empty/unset the field is hidden. Example:
# NEXT_PUBLIC_APPS=Website,Mobile App,API
NEXT_PUBLIC_APPS=
